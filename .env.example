# Optional settings for fresh LOCAL research runs. Playback needs none.
# No provider API keys are required; authenticate separately with: agent login
# Backend does not auto-load this file. From the repository root:
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   npm run dev:all
RESEARCH_MODEL=cursor-grok-4.6-high-fast
JAX_PLATFORMS=cpu
XLA_PYTHON_CLIENT_PREALLOCATE=false
# CURSOR_AGENT_BIN=/absolute/path/to/agent
# HARNESS_RUNTIME_DIR=/absolute/path/to/aster-research/runtime
# RESEARCH_PROPOSER_CWD=/absolute/path/to/aster-research/runtime/proposer
